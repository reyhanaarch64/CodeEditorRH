version:1
name:C
extensions:c,h
keywords:int,char,float,double,void,if,else,for,while,return,struct,typedef,include,define,static,const,null
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  default:#E6EDF3
rules:
  string: ".*?"|'.*?'
  comment: //.*$|#.*$|/\*.*?\*/
  number: \b\d+(\.\d+)?\b
