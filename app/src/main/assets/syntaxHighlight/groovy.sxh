version:1
name:Groovy
extensions:groovy,gradle
keywords:as,assert,break,case,catch,class,continue,def,default,do,else,enum,extends,false,finally,for,if,implements,import,in,instanceof,interface,new,null,package,return,super,switch,this,throw,throws,trait,true,try,while,var,public,private,protected,static,final,void
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  operator:#FFA657
  function:#D2A8FF
  type:#FFA657
  default:#E6EDF3
rules:
  comment: //.*$|/\*.*?\*/
  string: """.*?"""|\'\'\'.*?\'\'\'|".*?"|\'.*?\'
  number: \b\d+(\.\d+)?\b
  operator: [+\-*/%=!<>|&^~?:]+
