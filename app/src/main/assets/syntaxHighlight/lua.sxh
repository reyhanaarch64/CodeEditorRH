version:1
name:Lua
extensions:lua
keywords:and,break,do,else,elseif,end,false,for,function,goto,if,in,local,nil,not,or,repeat,return,then,true,until,while
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  operator:#FFA657
  function:#D2A8FF
  default:#E6EDF3
rules:
  comment: --.*$|--\[\[.*?\]\]
  string: ".*?"|\'.*?\'|\[\[.*?\]\]
  number: \b\d+(\.\d+)?\b
  operator: [+\-*/%=!<>|&^~:]+
