version:1
name:Cpp
extensions:cpp,cc,cxx,hpp
keywords:int,char,float,double,void,class,public,private,protected,if,else,for,while,return,new,delete,namespace,using,template,true,false,nullptr
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  default:#E6EDF3
rules:
  string: ".*?"|'.*?'
  comment: //.*$|#.*$|/\*.*?\*/
  number: \b\d+(\.\d+)?\b
