version:1
name:Python
extensions:py,pyw
keywords:def,class,import,from,as,if,elif,else,for,while,return,True,False,None,with,try,except,finally,raise,lambda,yield,async,await,pass,break,continue,and,or,not,in,is,global,nonlocal
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  default:#E6EDF3
rules:
  string: ".*?"|'.*?'
  comment: //.*$|#.*$|/\*.*?\*/
  number: \b\d+(\.\d+)?\b
