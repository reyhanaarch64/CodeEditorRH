version:1
name:INI
extensions:ini,cfg,conf
keywords:true,false,yes,no,on,off
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  property:#79C0FF
  value:#A5D6FF
  selector:#D2A8FF
  default:#E6EDF3
rules:
  comment: ;.*$|#.*$
  string: ".*?"|\'.*?\'
  selector: ^\[.*\]$
  number: \b\d+(\.\d+)?\b
