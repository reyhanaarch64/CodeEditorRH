version:1
name:Ruby
extensions:rb
keywords:def,class,module,end,if,else,elsif,for,while,return,true,false,nil,require,include,attr_accessor
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  default:#E6EDF3
rules:
  string: ".*?"|'.*?'
  comment: //.*$|#.*$|/\*.*?\*/
  number: \b\d+(\.\d+)?\b
