version:1
name:Rust
extensions:rs
keywords:fn,let,mut,const,struct,enum,impl,trait,pub,use,mod,if,else,for,while,loop,return,match,true,false,self,Self
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  default:#E6EDF3
rules:
  string: ".*?"|'.*?'
  comment: //.*$|#.*$|/\*.*?\*/
  number: \b\d+(\.\d+)?\b
