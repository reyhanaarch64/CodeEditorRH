version:1
name:Bash
extensions:sh,bash
keywords:if,then,else,fi,for,while,do,done,case,esac,function,return,echo,export,source
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  default:#E6EDF3
rules:
  string: ".*?"|'.*?'
  comment: //.*$|#.*$|/\*.*?\*/
  number: \b\d+(\.\d+)?\b
