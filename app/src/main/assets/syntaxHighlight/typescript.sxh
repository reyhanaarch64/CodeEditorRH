version:1
name:Typescript
extensions:ts,tsx
keywords:var,let,const,function,return,if,else,for,while,class,interface,type,import,export,from,async,await,true,false,null,undefined
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  default:#E6EDF3
rules:
  string: ".*?"|'.*?'
  comment: //.*$|#.*$|/\*.*?\*/
  number: \b\d+(\.\d+)?\b
