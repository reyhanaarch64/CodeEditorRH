version:1
name:TypeScript
extensions:ts,tsx
keywords:abstract,any,as,asserts,async,await,bigint,boolean,break,case,catch,class,const,constructor,continue,debugger,declare,default,delete,do,else,enum,export,extends,false,finally,for,from,function,get,if,implements,import,in,infer,instanceof,interface,is,keyof,let,module,namespace,never,new,null,number,object,of,package,private,protected,public,readonly,require,return,set,static,string,super,switch,symbol,this,throw,true,try,type,typeof,undefined,unique,unknown,var,void,while,with,yield
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  operator:#FFA657
  function:#D2A8FF
  type:#FFA657
  default:#E6EDF3
rules:
  comment: //.*$|/\*.*?\*/
  string: `.*?`|".*?"|\'.*?\'
  number: \b\d+(\.\d+)?([eE][+-]?\d+)?\b
  operator: [+\-*/%=!<>|&^~?:]+
