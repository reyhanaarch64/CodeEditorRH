// sxh v3
lang TypeScript {
  ext ts tsx

  color keyword #FF7B72
  color string #A5D6FF
  color comment #8B949E
  color number #79C0FF
  color default #E6EDF3

  keyword {
    var let const function return if else for while class interface type import export
    from async await true false null undefined typeof instanceof enum namespace declare
    public private protected readonly abstract implements extends
  }

  match string /"(?:[^"\\]|\\.)*"/
  match string /'(?:[^'\\]|\\.)*'/
  match string /`(?:[^`\\]|\\.)*`/
  match comment /\/\/.*$/
  match comment /\/\*[\s\S]*?\*\//
  match number /\b\d+(\.\d+)?([eE][+-]?\d+)?\b/
}
