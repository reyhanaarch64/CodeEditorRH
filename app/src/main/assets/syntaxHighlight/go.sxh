version:1
name:Go
extensions:go
keywords:func,package,import,var,const,type,struct,interface,map,chan,if,else,for,range,return,go,defer,select,switch,case,break,continue,true,false,nil
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  default:#E6EDF3
rules:
  string: ".*?"|'.*?'
  comment: //.*$|#.*$|/\*.*?\*/
  number: \b\d+(\.\d+)?\b
