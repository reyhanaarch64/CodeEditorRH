version:1
name:Sql
extensions:sql
keywords:SELECT,FROM,WHERE,INSERT,UPDATE,DELETE,CREATE,TABLE,JOIN,ON,AS,AND,OR,NOT,NULL,ORDER,BY,GROUP,HAVING,LIMIT
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  default:#E6EDF3
rules:
  string: ".*?"|'.*?'
  comment: //.*$|#.*$|/\*.*?\*/
  number: \b\d+(\.\d+)?\b
