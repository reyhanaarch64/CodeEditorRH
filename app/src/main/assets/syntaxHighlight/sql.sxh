// sxh v3
lang SQL {
  ext sql

  color keyword #FF7B72
  color string #A5D6FF
  color comment #8B949E
  color number #79C0FF
  color default #E6EDF3

  keyword {
    SELECT FROM WHERE INSERT UPDATE DELETE CREATE TABLE JOIN ON AS AND OR NOT NULL
    ORDER BY GROUP HAVING LIMIT OFFSET INNER LEFT RIGHT FULL OUTER DISTINCT
  }

  match string /'(?:[^'\\]|\\.)*'/
  match comment /--.*$/
  match comment /\/\*[\s\S]*?\*\//
  match number /\b\d+(\.\d+)?\b/
}
