version:1
name:Zig
extensions:zig
keywords:addrspace,align,allowzero,and,anyframe,anytype,asm,async,await,break,callconv,catch,comptime,const,continue,defer,else,enum,errdefer,error,export,extern,false,fn,for,if,inline,noalias,nosuspend,opaque,or,orelse,packed,pub,return,linksection,struct,suspend,switch,test,threadlocal,true,try,undefined,union,unreachable,usingnamespace,var,volatile,while,null
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  operator:#FFA657
  function:#D2A8FF
  type:#FFA657
  default:#E6EDF3
rules:
  comment: //.*$
  string: ".*?"|\'.*?\'
  number: \b\d+(\.\d+)?\b
  operator: [+\-*/%=!<>|&^~?:]+
