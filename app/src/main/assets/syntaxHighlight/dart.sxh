version:1
name:Dart
extensions:dart
keywords:void,var,final,const,class,extends,implements,if,else,for,while,return,true,false,null,async,await,import
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  default:#E6EDF3
rules:
  string: ".*?"|'.*?'
  comment: //.*$|#.*$|/\*.*?\*/
  number: \b\d+(\.\d+)?\b
