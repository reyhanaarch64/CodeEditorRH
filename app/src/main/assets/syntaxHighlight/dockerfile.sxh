version:1
name:Dockerfile
extensions:dockerfile
keywords:ADD,ARG,CMD,COPY,ENTRYPOINT,ENV,EXPOSE,FROM,HEALTHCHECK,LABEL,ONBUILD,RUN,SHELL,STOPSIGNAL,USER,VOLUME,WORKDIR,MAINTAINER
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  operator:#FFA657
  default:#E6EDF3
rules:
  comment: #.*$
  string: ".*?"|\'.*?\'
  number: \b\d+(\.\d+)?\b
