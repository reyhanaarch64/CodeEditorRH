version:1
name:PowerShell
extensions:ps1,psm1,psd1
keywords:begin,break,catch,class,continue,data,do,dynamicparam,else,elseif,end,exit,filter,finally,for,foreach,function,if,in,param,process,return,switch,throw,trap,try,until,using,while,workflow,parallel,sequence
colors:
  keyword:#FF7B72
  string:#A5D6FF
  comment:#8B949E
  number:#79C0FF
  operator:#FFA657
  function:#D2A8FF
  default:#E6EDF3
rules:
  comment: #.*$|<#.*?#>
  string: ".*?"|\'.*?\'
  number: \b\d+(\.\d+)?\b
  operator: [+\-*/%=!<>|&^~?:]+
