// sxh v3
lang PHP {
  ext php

  color keyword #FF7B72
  color string #A5D6FF
  color comment #8B949E
  color number #79C0FF
  color default #E6EDF3

  keyword {
    function class public private protected static return if else elseif for foreach while
    echo print new this try catch finally throw namespace use const var true false null
    array isset empty unset switch case break continue
  }

  match string /"(?:[^"\\]|\\.)*"/
  match string /'(?:[^'\\]|\\.)*'/
  match comment /\/\/.*$/
  match comment /#.*$/
  match comment /\/\*[\s\S]*?\*\//
  match number /\b\d+(\.\d+)?\b/
}
